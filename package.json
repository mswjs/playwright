    "app:start": "vite",
    "lint": "publint",
    "build": "tsdown",
    "release": "release publish"
  },
  "files": [
    "./src",
    "./build"
  ],
  "keywords": [
    "playwright",
    "api",
    "mock",
    "msw",
    "request"
