{
  "type": "module",
  "name": "@msw/playwright",
  "version": "0.6.7",
  "description": "Mock Service Worker binding for Playwright",
  "main": "./build/index.mjs",
  "types": "./build/index.d.mts",
  "exports": {
    ".": {
      "types": "./build/index.d.mts",
      "default": "./build/index.mjs"
    }
  },
  "scripts": {
    "dev": "tsdown --watch",
    "test": "playwright test",
